# Copy to backend/.env and fill in a NEW key after rotating any leaked key.
WANDB_API_KEY=
WEAVE_PROJECT=rshah88-arizona-state-university/agent-jail
ARIA_COACH_MODEL=zai-org/GLM-5.3-Flash

# mock (offline/default) or coreweave (real ephemeral CoreWeave Sandbox)
AGENTJAIL_EXECUTOR=mock

# arga: execute allowed calls against an Arga Labs service twin (GitHub twin).
# AGENTJAIL_EXECUTOR=arga
# ARGA_API_KEY=arga_sk_...
# ARGA_TWIN=github
# ARGA_GITHUB_REPO=agentjail/infra
# ARGA_TTL_MINUTES=10
# ARGA_GITHUB_TOKEN=   # copy from the twin page in the Arga web app if env_vars is empty
